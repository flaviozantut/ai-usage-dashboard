# Storage — the single local SQLite file the hooks write to and the MCP reads from.
# Default is ./metrics.db at the repo root; override if you keep it elsewhere.
DB_PATH=./metrics.db

# Cursor (exact-token collector via Admin API)
CURSOR_API_KEY=cursor-admin-key              # Cursor Dashboard → Settings → Admin API Keys
CURSOR_DAYS=30                               # lookback window

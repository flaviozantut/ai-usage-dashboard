# API de ingestão
PORT=8787
DB_PATH=./metrics.db

# Coletores (exporte no shell ao rodar collect:claude / collect:cursor)
DASH_API=http://localhost:8787/events

# Cursor (coletor de tokens exatos via Admin API)
CURSOR_API_KEY=admin-key-do-cursor           # Cursor Dashboard → Settings → Admin API Keys
CURSOR_DAYS=30                               # janela para trás

# Ingestion API
PORT=8787
DB_PATH=./metrics.db

# Collectors (export in your shell when running collect:claude / collect:cursor)
DASH_API=http://localhost:8787/events

# Cursor (exact-token collector via Admin API)
CURSOR_API_KEY=cursor-admin-key              # Cursor Dashboard → Settings → Admin API Keys
CURSOR_DAYS=30                               # lookback window
